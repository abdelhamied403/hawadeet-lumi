# Where the kids' Veogen server listens (apps/server, SERVER_PORT).
VEOGEN_URL=http://127.0.0.1:4527
# The Claude Code CLI and the model that reviews every step.
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5-5
# How often the server is asked for steps waiting for review.
POLL_SECONDS=60
# After this many rejections of one step, it is handed to the owner instead of being sent back again.
MAX_REJECTIONS=3
