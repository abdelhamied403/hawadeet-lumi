# Kaggle: Settings -> API. The account must be phone-verified to get GPU and internet in jobs.
KAGGLE_USERNAME=
# Either the legacy key from kaggle.json, or a new-style token starting with KGAT_
KAGGLE_KEY=

# Optional overrides (VOICE_STYLE holds the acting direction for the narrator)
# GEMINI_VOICE=Charon
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# CAPTION_FONT=Noto Kufi Arabic
# CAPTION_FONTS_DIR=/usr/share/fonts/truetype/noto

# Google AI Studio key (https://aistudio.google.com/apikey), used for the expressive voice and story writing
GEMINI_API_KEY=

# Facebook Page publishing (optional): a Page ID and a Page access token with permission to publish Reels
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# YouTube uploads (optional): an OAuth client of type "Desktop app" from Google Cloud with the YouTube Data API
# enabled. `bun run youtube-connect` then stores YOUTUBE_REFRESH_TOKEN here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Phone alerts (optional): a private, hard-to-guess topic name; subscribe to it in the ntfy app.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Remote access (optional): set both to require a login, which is needed before HOST is anything but 127.0.0.1.
# AUTH_PASSWORD is the owner's password (12+ characters); JWT_SECRET is 32+ random characters.
AUTH_PASSWORD=
JWT_SECRET=
# HOST=127.0.0.1
